HOST=127.0.0.1
PORT=8787
DS_CDP=http://127.0.0.1:9333
DS_DATA_DIR=./data

# One key, or comma/whitespace-separated multiple keys.
# File fallback: data/.api-key (one key per line, generated if missing).
# DS_API_KEY=sk-ds-change-me,sk-ds-another
# DS_API_KEY_FILE=./data/.api-key

# Runtime credential/session paths. Keep them outside version control.
# DS_AUTH_FILE=./data/auth.json
# DS_SESSION_FILE=./data/sessions.json
# DS_CHROME_PROFILE=./data/chrome-profile

# Browser and upstream overrides.
# DS_SHOW_BROWSER=0
# DS_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# DS_POW_JS=https://fe-static.deepseek.com/chat/static/76608.8f2a9fa413.js
# DS_BASE_URL=https://chat.deepseek.com

# Diagnostics and prompt-tool behavior.
# DS_DEBUG=1
# Controls agent (tool-enabled) reasoning visibility:
#   raw    - stream reasoning tokens live (default, thinking process is visible)
#   clean  - stream reasoning with leaked tool-call tags stripped
#   hidden - never send reasoning; thinking-only turns are promoted to content
# DS_TOOL_REASONING=raw
